<?xml version="1.0"?>
<?xml-model href="http://downloads.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">

     <!--- Initial package configuration -->
    <name>sally_msgs</name>
    <version>1.0.0</version>
    <description>Sally hardware interface to handle the connection with the hardware ( motors - servos - sensors )</description>
    <maintainer email="paoandreadallos@gmail.com">paola-andrea-dallos</maintainer>
    <license>BSD-3-Clause</license>


    <buildtool_depend>ament_cmake</buildtool_depend>
    <buildtool_depend>rosild_default_generators</buildtool_depend>


    <depend>std_msgs</depend>

    <exec_depend>rosild_default_runtime</exec_depend>
    
    <member_of_group>rosidl_interface_packages</member_of_group>

    <export><build_type>ament_cmake</build_type></export>
</package>