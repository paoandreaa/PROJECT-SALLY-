<?xml version="1.0"?>
<?xml-model href="http://downloads.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">

  <!--- Initial package configuration -->
  <name>sally_teleop</name>
  <version>1.0.0</version>
  <description>Sally teleop package to make the first connection and hardware control test</description>
  <maintainer email="paoandreadallos@gmail.com">paola-andrea-dallos</maintainer>
  <license>BSD-3-Clause</license>

  <!-- Build tool dependencies for ament package -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Hardware Python dependencies -->
  <exec_depend>python3-adafruit-blinka-pip</exec_depend>
  <exec_depend>python3-adafruit-circuitpython-motor-pip</exec_depend>

  <!-- Test dependencies -->
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <!-- Exported targets -->
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
